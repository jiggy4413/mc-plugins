<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jiggy4413</groupId>
        <artifactId>mc-plugins</artifactId>
        <version>2.0.6</version>
    </parent>

    <artifactId>prison-core</artifactId>
    <name>PrisonCore</name>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <!-- Rankup 3.11.3 API (provided by the Rankup plugin at runtime) -->
        <dependency>
            <groupId>io.github.jiggy4413</groupId>
            <artifactId>rankup-api-stubs</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- PlaceholderAPI 2.10.x API (provided by the PlaceholderAPI plugin at runtime, optional) -->
        <dependency>
            <groupId>io.github.jiggy4413</groupId>
            <artifactId>placeholderapi-stubs</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- EconomyShopGUI API (provided by EconomyShopGUI at runtime, used by /prisoncore sellall) -->
        <dependency>
            <groupId>io.github.jiggy4413</groupId>
            <artifactId>economyshopgui-api-stubs</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>PrisonCore-${project.version}</finalName>
        <resources>
            <!-- Fills ${project.version} into plugin.yml at build time -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <!-- Everything else is copied as-is (configs use {placeholders} and $ signs) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- PrisonCore uses no server internals, so tell Paper not to remap it. Without this Paper
                 runs it from a copy in plugins/.paper-remapped/, and /prisoncore reload can't see new jars. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
